{
  "name": "inmocontrol",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-server/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "server": "tsx watch server.ts",
    "dev": "node scripts/dev-all.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch server.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "start": "NODE_ENV=production node dist-server/server.js",
    "test": "node --test --import tsx tests/settlement.test.ts tests/numeroALetras.test.ts",
    "smoke": "node --import tsx scripts/smoke-test-e2e.mjs",
    "test:auth": "node scripts/test-auth-e2e.mjs",
    "backup": "node scripts/backup-db.mjs",
    "seed:pilot": "node scripts/seed-pilot.mjs",
    "align:schema": "node scripts/align-schema-compat.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "googleapis": "^173.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "mysql2": "^3.22.5",
    "nodemailer": "^9.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "twilio": "^5.4.0",
    "vite": "^6.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
