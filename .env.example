# ============================================================================
# InmoControl — Variables de entorno (.env.example)
# ============================================================================
# Copia este archivo como `.env.local` y ajusta los valores según tu entorno.
# Si NO existe `.env.local`, la app usa los defaults (MySQL local en
# 127.0.0.1:3306, user root, password vacío, db inmocontrol).
#
# ════════════════════════════════════════════════════════════════════════════
# REGLAS PARA EL PILOTO (2026-07)
# ════════════════════════════════════════════════════════════════════════════
# 1. Las vars marcadas [PILOTO REQUERIDO] son obligatorias para arrancar.
# 2. Las vars marcadas [PILOTO OPCIONAL] son mejoras (Twilio, Email, OAuth).
#    La app abre sin ellas — entra en modo mock/log.
# 3. GEMINI_API_KEY está OBSOLETO desde Fase 5 — la app ya no usa Gemini.
#    Déjala vacía o elimínala (no genera error).
# 4. NUNCA commitees `.env.local` con credenciales reales. Solo este archivo
#    (`.env.example`) va al repo.
# ════════════════════════════════════════════════════════════════════════════

# ─── 1. App [PILOTO REQUERIDO] ──────────────────────────────────────────
APP_URL=http://localhost:3000
NODE_ENV=development

# ─── 2. MySQL [PILOTO REQUERIDO] ────────────────────────────────────────
# Requeridos solo si quieres que la app lea/escriba del MySQL local.
# Si MySQL no responde, los endpoints devuelven 503 y el cliente hace fallback
# a localStorage (modo demo).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# ⚠️  En producción NUNCA dejar vacío. Para el piloto local, MySQL con
# password vacío está OK (servidor local sin acceso externo).
DB_PASSWORD=
DB_NAME=inmocontrol
DB_LIMIT=10

# ─── 3. Google OAuth / Drive [PILOTO OPCIONAL] ──────────────────────────
# Si configuras estos vars, los agentes pueden conectar Drive y los PDFs
# se suben automáticamente. Si NO los configuras, los PDFs solo se descargan
# localmente — el flujo sigue funcionando, sin Drive.
#
# Crear proyecto: https://console.cloud.google.com/ → APIs & Services →
# Credentials → OAuth 2.0 Client ID (Web application)
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# ─── 4. Twilio WhatsApp [PILOTO OPCIONAL] ───────────────────────────────
# Sandbox (gratis, 5 min de setup):
#   1. Crear cuenta en https://console.twilio.com
#   2. Console → Messaging → Try it out → WhatsApp → copiar el sandbox number
#   3. Console → Account → API keys & tokens → copiar Account SID + Auth Token
# Sandbox limita: destinatario debe mandar "join <palabra>" antes.
# Producción: cambiar TWILIO_WHATSAPP_FROM al número +57 aprobado por Meta.
# Si falta alguna var, el adapter hace fallback a modo mock (loguea en consola,
# no envía nada real).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── 5. Email [PILOTO OPCIONAL] ─────────────────────────────────────────
# Si la agencia NO configura sus propios mailboxes en Settings → Integraciones,
# el server puede usar estas credenciales como fallback (modo "centralized").
# SMTP genérico (Gmail con App Password, Outlook, hosting):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM_NAME=InmoControl
EMAIL_FROM_EMAIL=
# Alternativa: SendGrid (recomendado para producción):
SENDGRID_API_KEY=
EMAIL_FALLBACK_ENABLED=false

# ─── 6. LEGACY — NO SE USA EN EL PILOTO ─────────────────────────────────
# Estas dos variables vienen de Fase 1 (cuando había un backend Supabase).
# La app actualmente NO las lee. Déjalas vacías o bórralas, da igual.
GEMINI_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── 7. AUTH PILOTO ─────────────────────────────────────────────────────
# La contraseña del usuario seed (admin@inmocontrol.local) está en la DB,
# hasheada con bcrypt. Este env var controla la duración de la sesión en
# horas (default 12h). Para el piloto no tocar.
PILOT_SESSION_HOURS=12